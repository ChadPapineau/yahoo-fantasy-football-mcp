#!/bin/sh
# pre-commit — block secrets and personal identifiers before they reach a commit.
# Scans the STAGED content of every added/copied/modified/renamed file.
# Enabled per clone with:  git config core.hooksPath .githooks
# (scripts/dev/commit-paths.sh runs the same scanner itself, since it commits via
# plumbing that does not fire hooks.) Never bypass with --no-verify.
root=$(git rev-parse --show-toplevel) || exit 1
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
printf '%s\n' "$files" | tr '\n' '\0' | \
  xargs -0 "$root/scripts/dev/with-node.sh" node "$root/scripts/dev/scan-secrets.mjs" --staged -- || {
  echo "pre-commit: secret/identifier scan failed — commit blocked" >&2
  exit 1
}
