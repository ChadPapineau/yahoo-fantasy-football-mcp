# ---------------------------------------------------------------------------
# yahoo-fantasy-football-mcp — example environment
#
# Copy to `.env` (which is git-ignored) and fill in real values.
# EVERY value below is a placeholder. Never commit a real .env.
#
# Real OAuth tokens are NOT stored in .env or anywhere in this repo — they are
# persisted by the server to a per-user store outside the repository (see
# YFF_TOKEN_STORE). This matters if your checkout lives in a cloud-synced
# folder.
# ---------------------------------------------------------------------------

# --- Yahoo Developer app (https://developer.yahoo.com/apps/) ---------------
# Create an app with the Fantasy Sports "Read/Write" permission.
YAHOO_CLIENT_ID=your-yahoo-client-id-here
YAHOO_CLIENT_SECRET=your-yahoo-client-secret-here

# Redirect URI registered on the Yahoo app. Must match exactly.
# The exact value the server expects is documented in docs/ (settled in the
# architecture plan); this is a placeholder.
YAHOO_REDIRECT_URI=https://localhost:8787/oauth/callback

# --- Token persistence (outside the repo) ---------------------------------
# Absolute path, or a path starting with ~ . Created with mode 0600.
YFF_TOKEN_STORE=~/.config/yahoo-fantasy-football-mcp/tokens.json

# --- Server behaviour ----------------------------------------------------
# One of: error | warn | info | debug. Logs go to stderr, never stdout
# (stdout is the MCP stdio transport).
YFF_LOG_LEVEL=info

# Local cache location for third-party NFL data (outside the repo by default).
YFF_CACHE_DIR=~/.cache/yahoo-fantasy-football-mcp

# --- Optional third-party data providers (placeholders; none required) ----
# Leave blank to disable a provider. Values are never logged.
# ODDS_API_KEY=
# WEATHER_API_KEY=
