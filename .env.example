# ---------------------------------------------------------------------------
# fantasy-football-mcp — every environment key the server reads.
#
# Generated from and tested against src/config/schema.ts (CONFIG_KEY_SPECS);
# tests/config/schema.test.ts fails if this file and the schema disagree.
#
# The server does NOT read a .env file: set these in your MCP client's "env"
# block (`ff print-config` prints one) or in your shell. Every line below is
# commented out and shows the default, or nothing. Never put a real value in
# this file, and never commit a filled-in copy (.env* is git-ignored).
#
# Precedence: environment > <config>/config.json > default (plan 03 §3).
# Secrets are env-only: config.json may not hold them.
# ---------------------------------------------------------------------------

# --- Locations (absolute paths or ~/; never inside this checkout, never in
#     Documents/Desktop/iCloud Drive) -----------------------------------------

# Config directory (0700): league.yaml and config.json live here. Env only.
# Default: $XDG_CONFIG_HOME/fantasy-football-mcp, else ~/.config/fantasy-football-mcp
# FF_CONFIG_DIR=

# Cache directory (0700): store.sqlite, ds/ dataset files, backups.
# Default: $XDG_CACHE_HOME/fantasy-football-mcp, else ~/.cache/fantasy-football-mcp
# FF_CACHE_DIR=

# Manual league file (0600) — holds your real league/team names, so it lives
# outside the repo. Default: <config>/league.yaml
# FF_LEAGUE_FILE=

# --- Behaviour ----------------------------------------------------------------

# stderr log level: error | warn | info | debug (stdout carries MCP only).
# FF_LOG_LEVEL=info

# Registered tools: core (the 19 P0 tools) | full (adds P1/P2 analytics).
# FF_TOOLSET=core

# Weather driver: open-meteo (non-commercial) | nws (US, public domain) | off.
# FF_WEATHER_SOURCE=open-meteo

# Fixture mode (tests, smoke, debug tools): an absolute fixtures directory.
# FF_FIXTURE_DIR=

# Optional comma-separated allow-list of league keys (e.g. 461.l.1000,manual.l.example).
# FF_LEAGUE_KEYS=

# Writes are not supported in this build: always off. Setting 1 is ignored
# with a warning (plan 02 §3.4; Phase W).
# FF_WRITE_ENABLED=0

# --- Phase 1b — not used (no Yahoo API access; YahooProvider is not built) ----

# Fixed port for `ff auth --listener`.
# FF_AUTH_PORT=

# Yahoo app client id.
# YAHOO_CLIENT_ID=

# Yahoo client secret. Env only; prefer the _FILE form below.
# YAHOO_CLIENT_SECRET=

# Path to a 0600 file holding the client secret. Default: <config>/client_secret
# YAHOO_CLIENT_SECRET_FILE=

# --- Deferred (plan 10 D4) — not used -----------------------------------------

# The Odds API key. Env only.
# ODDS_API_KEY=
